<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="br.com.calendar.controllers.LoginController"
        fx:id="root"
        prefWidth="1280"
        prefHeight="1024"
        styleClass="login-root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <HBox fx:id="loginCard" 
        styleClass="login-card"
        prefWidth="1200"
        prefHeight="648"
        maxWidth="1200" 
        maxHeight="648">


        <!-- ===== Left panel (branding) ===== -->
        <VBox fx:id="brandPanel" 
            styleClass="login-brand-panel"
            prefWidth="600"
            minWidth="0"
            HBox.hgrow="ALWAYS">

            <padding>
                <Insets top="40" right="48" bottom="40" left="48"/>
            </padding>

        <!-- Logo + name -->
            <HBox spacing="12" 
                alignment="CENTER_LEFT">

                <StackPane styleClass="login-logo-badge">

                    <FontIcon iconLiteral="mdi2c-calendar" 
                        styleClass="login-logo-icon"/>

                </StackPane>

                <Label text="Project A" 
                    styleClass="login-brand-name"/>
            </HBox>

            <Region minHeight="48" VBox.vgrow="NEVER"/>

            <!-- Headline -->
            <TextFlow maxWidth="380">

                <Text fx:id="headlineMain"
                    styleClass="login-headline"
                    text="Foque no que "/>
                
                <Text fx:id="headlineSecondary"
                    styleClass="login-headline"
                    text="&#10;mais importa."/>

            </TextFlow> 

            <Region minHeight="20" VBox.vgrow="NEVER"/>

            <!-- Description -->
            <TextFlow maxWidth="380">
                <Text styleClass="login-description"
                    text="Junte-se a milhares de profissionais que utilizam o ambiente de agendamento mais intuitivo e livre de distrações."/>
            </TextFlow>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Tip card -->
            <HBox styleClass="login-tip-card" 
                spacing="14" 
                alignment="CENTER_LEFT">

                <StackPane styleClass="login-tip-icon-circle">

                    <FontIcon iconLiteral="mdi2a-auto-fix" 
                        styleClass="login-tip-icon"/>

                </StackPane>

                <VBox spacing="2">

                    <Label text="IMPULSO DE EFICIÊNCIA" 
                        styleClass="login-tip-label"/>

                    <Label text="O menu de comandos (Ctrl+K) já está disponível." 
                        styleClass="login-tip-text" 
                        wrapText="true"/>

                </VBox>
            </HBox>
        </VBox>

        <!-- ===== Right panel (form) ===== -->
        <StackPane fx:id="formPanel" 
            styleClass="login-form-panel" 
            HBox.hgrow="ALWAYS"
            prefWidth="600"
            minWidth="0" 
            alignment="CENTER">

            <VBox fx:id="formContent" 
                styleClass="login-form-content" 
                alignment="TOP_LEFT" 
                spacing="18">

                <padding>
                    <Insets top="50" right="0" bottom="0" left="0"/>
                </padding>

                <VBox spacing="4">

                    <Label text="Bem-vindo de volta" 
                        styleClass="login-form-title"/>
                    
                    

                    <Label text="Por favor, insira seus dados para entrar." 
                        styleClass="login-form-subtitle"/>

                    <padding>
                        <Insets top="0" right="0" bottom="30" left="0"/>
                    </padding>

                </VBox>

            <!-- Email -->
            <VBox spacing="6">

                    <Label text="Endereço de E-Mail" 
                        styleClass="field-label"/>

                    <HBox styleClass="input-wrapper" 
                        alignment="CENTER_LEFT">

                        <FontIcon iconLiteral="mdi2e-email-outline" 
                            styleClass="input-icon"/>

                        <TextField fx:id="emailField" 
                            promptText="nome@empresa.com"
                            styleClass="input-inner" 
                            HBox.hgrow="ALWAYS"/>

                    </HBox>
                    <Label fx:id="emailErrorLabel" 
                        styleClass="error-label" 
                        managed="false" 
                        visible="false"/>

                </VBox>
            
            <!-- Password -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">

                        <Label text="Senha" 
                            styleClass="field-label" 
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                        <Hyperlink fx:id="forgotPasswordLink" 
                            text="Esqueceu a senha?"
                            styleClass="inline-link" 
                            onAction="#handleGoToForgotPassword"/>

                    </HBox>

                    <HBox styleClass="input-wrapper" 
                        alignment="CENTER_LEFT">

                        <FontIcon iconLiteral="mdi2l-lock-outline" 
                            styleClass="input-icon"/>

                        <PasswordField fx:id="passwordField" 
                            promptText="Senha"
                            styleClass="input-inner" 
                            HBox.hgrow="ALWAYS"/>

                    </HBox>

                    <Label fx:id="passwordErrorLabel" 
                        styleClass="error-label" 
                        managed="false" 
                        visible="false"/>

                </VBox>

                <Label fx:id="generalErrorLabel" 
                    styleClass="error-label general-error" 
                    managed="false" 
                    visible="false"/>

                <Button fx:id="loginButton" 
                    text="Entrar" 
                    styleClass="login-primary-button"
                    maxWidth="Infinity" 
                    onAction="#handleLogin"/>

                <HBox alignment="CENTER" spacing="14">

                    <padding>
                        <Insets top="20" right="0" bottom="20" left="0"/>
                    </padding>

                    <Separator HBox.hgrow="ALWAYS"/>

                    <Label text="OU ENTRAR COM" 
                        styleClass="divider-label"/>

                    <Separator HBox.hgrow="ALWAYS"/>

                </HBox>

                <HBox spacing="16">

                    <Button fx:id="googleLoginButton" 
                        text="Google" 
                        styleClass="social-button"
                        HBox.hgrow="ALWAYS" 
                        maxWidth="Infinity" 
                        onAction="#handleGoogleLogin"
                        contentDisplay="LEFT" 
                        graphicTextGap="8">

                        <graphic>
                            <ImageView fitWidth="18" 
                                fitHeight="18" 
                                preserveRatio="true">

                                <image>
                                    <Image url="@../images/google_logo.png"/>
                                </image>

                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="githubLoginButton" 
                            text="GitHub" 
                            styleClass="social-button"
                            HBox.hgrow="ALWAYS" 
                            maxWidth="Infinity" 
                            onAction="#handleGithubLogin"
                            contentDisplay="LEFT" 
                            graphicTextGap="8">

                        <graphic>
                            <ImageView fitWidth="18" 
                                fitHeight="18" 
                                preserveRatio="true">

                                <image>
                                    <Image url="@../images/github_logo.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

            <HBox alignment="CENTER" 
                spacing="5">

                    <Label text="Não tem uma conta?" 
                        styleClass="footer-text"/>

                    <padding>
                        <Insets top="20" right="0" bottom="0" left="0"/>
                    </padding>

                    <Hyperlink fx:id="signupLink" 
                        text="Criar Conta" 
                        styleClass="inline-link"
                        onAction="#handleGoToSignup"/>
                        
                </HBox>

                <Region minHeight="10"/>

                <HBox alignment="CENTER">

                    <padding>
                        <Insets top="0" right="0" bottom="20" left="0"/>
                    </padding>

                    <Label text="© 2026 Project A. Gestão profissional de horários." 
                    styleClass="copyright-label"/>


                </HBox>
            </VBox>
        </StackPane>

    </HBox>
</StackPane>
    